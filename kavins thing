<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<title>3D Spinning Airplane</title>


<style>

body{

    margin:0;

    background:#87ceeb;

    display:flex;

    justify-content:center;

    align-items:center;

    height:100vh;

    perspective:800px;

}


.scene{

    width:300px;

    height:300px;

    position:relative;

}


.airplane{

    width:200px;

    height:60px;

    position:absolute;

    top:120px;

    left:50px;

    transform-style:preserve-3d;

    animation:spin 6s linear infinite;

}


/* Body */

.body{

    position:absolute;

    width:200px;

    height:20px;

    background:white;

    border-radius:10px;

    top:20px;

}


/* Wings */

.wing{

    position:absolute;

    width:120px;

    height:10px;

    background:lightgray;

    top:25px;

    left:40px;

    transform:rotateY(90deg);

}


/* Tail */

.tail{

    position:absolute;

    width:20px;

    height:20px;

    background:white;

    right:-10px;

    top:0;

}


@keyframes spin{

    from{ transform: rotateY(0deg) rotateX(10deg); }

    to{ transform: rotateY(360deg) rotateX(10deg); }

}

</style>

</head>


<body>


<div class="scene">

    <div class="airplane">

        <div class="body"></div>

        <div class="wing"></div>

        <div class="tail"></div>

    </div>

</div>


</body>

</html>

